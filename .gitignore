.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron
.env

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

#reference files
sequence_gathering.qmd
genome_metadata.tsv
.posit/assistant

# Große, reproduzierbare NCBI-Rohdownloads: nicht auf GitHub.
# Sie lassen sich jederzeit aus der Metadatentabelle erneut beschaffen.
genomes/fasta/
genomes/genbank/
genomes/gff3/

# Lauf-Artefakte (Logs, Cache) sind nicht Teil des Projektstands.
data/cache/
data/logs/

# data/metadata/ wird BEWUSST versioniert, damit nachvollziehbar bleibt,
# welche NCBI-Records die Grundlage eines Projektstands waren:
#   data/metadata/baculovirus_genome_metadata.tsv
#   data/metadata/ncbi_query_metadata.json
#   data/metadata/date_field_sources.tsv
#   data/metadata/metadata_field_classification.tsv
# Es darf hier daher keine data/metadata-Ignore-Regel geben.

